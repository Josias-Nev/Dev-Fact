<aside class="sidebar">
    <div class="brand">
        <div class="brand-mark">DF</div>
        <div class="brand-text">
            <strong>Dev-Fact</strong>
            <span>Devis &amp; Factures</span>
        </div>
    </div>

    <nav class="nav">
        <div class="nav-section">Gestion commerciale</div>
        <a class="nav-link ${active == 'devis' ? 'is-active' : ''}"
           href="${pageContext.request.contextPath}/documents?type=DEVIS">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
            Devis
        </a>
        <a class="nav-link ${active == 'factures' ? 'is-active' : ''}"
           href="${pageContext.request.contextPath}/documents?type=FACTURE">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h16v18l-4-3-4 3-4-3-4 3z"/><path d="M8 8h8"/><path d="M8 12h6"/></svg>
            Factures
        </a>
        <a class="nav-link ${active == 'clients' ? 'is-active' : ''}"
           href="${pageContext.request.contextPath}/clients">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Clients
        </a>

        <c:if test="${currentUser.admin}">
            <div class="nav-section">Administration</div>
            <a class="nav-link ${active == 'settings' ? 'is-active' : ''}"
               href="${pageContext.request.contextPath}/settings">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Paramètres
            </a>
        </c:if>
    </nav>

    <div class="sidebar-foot">
        <div class="user-chip">
            <div class="avatar"><c:out value="${currentUser.initials}"/></div>
            <div class="user-meta">
                <strong><c:out value="${currentUser.fullName}"/></strong>
                <span><c:out value="${currentUser.roleLabel}"/></span>
            </div>
        </div>
        <form class="logout-form" method="post" action="${pageContext.request.contextPath}/logout">
            <input type="hidden" name="_csrf" value="${csrfToken}">
            <button class="btn btn-secondary btn-sm btn-block" type="submit">Se déconnecter</button>
        </form>
    </div>
</aside>
